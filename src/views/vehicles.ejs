<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Vehicles – Fleet Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    body { background:#f0f2f5; }
    .sidebar-link {
      display:block; color:#adb5bd; text-decoration:none;
      padding:.6rem .8rem; border-radius:6px; margin-bottom:4px; font-size:.9rem;
    }
    .sidebar-link:hover, .sidebar-link.active { background:#343a40; color:#fff; }
    .badge-available { background:#d1fae5; color:#065f46; }
    .badge-maintenance { background:#fee2e2; color:#991b1b; }
    .badge-other { background:#e0e7ff; color:#3730a3; }
  </style>
</head>
<body class="d-flex flex-column" style="min-height:100vh;">

<%- include('partials/navbar', { page: 'vehicles' }) %>

<div class="d-flex flex-grow-1">
  <%- include('partials/sidebar', { page: 'vehicles' }) %>

  <main class="flex-grow-1 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">Vehicles</h4>
      <a href="/vehicles/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Vehicle
      </a>
    </div>

    <div class="card border-0 rounded-3 shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>License Plate</th>
                <th>Make / Model</th>
                <th>Mileage</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (vehicles.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-5">
                  No vehicles yet. <a href="/vehicles/new">Add your first vehicle</a>.
                </td>
              </tr>
              <% } %>
              <% vehicles.forEach((v, i) => { %>
              <tr>
                <td class="text-muted"><%= i + 1 %></td>
                <td class="fw-semibold"><%= v.license_plate %></td>
                <td><%= v.make_model %></td>
                <td><%= Number(v.current_mileage).toLocaleString() %> km</td>
                <td>
                  <span class="badge rounded-pill px-3 py-1
                    <%= v.status === 'Available' ? 'badge-available' : v.status === 'Maintenance' ? 'badge-maintenance' : 'badge-other' %>">
                    <%= v.status %>
                  </span>
                </td>
                <td>
                  <a href="/vehicles/<%= v.id %>/edit" class="btn btn-sm btn-outline-primary me-1">
                    <i class="bi bi-pencil"></i> Edit
                  </a>
                  <form action="/vehicles/<%= v.id %>/delete" method="POST" class="d-inline"
                        onsubmit="return confirm('Are you sure you want to delete this vehicle?')">
                    <button class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
