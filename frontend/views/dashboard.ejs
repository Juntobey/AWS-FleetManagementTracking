<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard – Fleet Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    body { background:#f0f2f5; }
    .sidebar-link {
      display:block; color:#adb5bd; text-decoration:none;
      padding:.6rem .8rem; border-radius:6px; margin-bottom:4px; font-size:.9rem;
    }
    .sidebar-link:hover, .sidebar-link.active { background:#343a40; color:#fff; }
    .stat-card { border:none; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,.08); }
    .badge-available { background:#d1fae5; color:#065f46; }
    .badge-maintenance { background:#fee2e2; color:#991b1b; }
    .badge-other { background:#e0e7ff; color:#3730a3; }
  </style>
</head>
<body class="d-flex flex-column" style="min-height:100vh;">

<%- include('partials/navbar', { page: 'dashboard' }) %>

<div class="d-flex flex-grow-1">
  <%- include('partials/sidebar', { page: 'dashboard' }) %>

  <main class="flex-grow-1 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">Dashboard</h4>
      <a href="/vehicles/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Vehicle
      </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3">
        <div class="card stat-card p-3">
          <div class="text-muted small mb-1">Total Vehicles</div>
          <div class="fs-2 fw-bold"><%= total %></div>
          <i class="bi bi-truck text-primary fs-4"></i>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card stat-card p-3">
          <div class="text-muted small mb-1">Available</div>
          <div class="fs-2 fw-bold text-success"><%= available %></div>
          <i class="bi bi-check-circle text-success fs-4"></i>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card stat-card p-3">
          <div class="text-muted small mb-1">Maintenance</div>
          <div class="fs-2 fw-bold text-danger"><%= maintenance %></div>
          <i class="bi bi-tools text-danger fs-4"></i>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card stat-card p-3">
          <div class="text-muted small mb-1">Avg Mileage</div>
          <div class="fs-2 fw-bold text-info"><%= avgMileage.toLocaleString() %></div>
          <i class="bi bi-speedometer text-info fs-4"></i>
        </div>
      </div>
    </div>

    <!-- Fleet Overview -->
    <div class="card border-0 rounded-3 shadow-sm mb-4 p-4 text-center">
      <h6 class="fw-bold mb-3">Fleet Overview</h6>
      <svg viewBox="0 0 400 120" xmlns="http://www.w3.org/2000/svg" style="max-width:400px;margin:auto;display:block;">
        <rect x="10" y="50" width="240" height="50" rx="8" fill="#1e3a5f"/>
        <rect x="250" y="65" width="120" height="35" rx="6" fill="#2563eb"/>
        <circle cx="60" cy="105" r="15" fill="#374151"/>
        <circle cx="60" cy="105" r="7" fill="#9ca3af"/>
        <circle cx="200" cy="105" r="15" fill="#374151"/>
        <circle cx="200" cy="105" r="7" fill="#9ca3af"/>
        <circle cx="320" cy="105" r="15" fill="#374151"/>
        <circle cx="320" cy="105" r="7" fill="#9ca3af"/>
        <rect x="30" y="30" width="100" height="30" rx="4" fill="#2563eb"/>
        <rect x="15" y="60" width="30" height="20" rx="2" fill="#93c5fd"/>
        <rect x="120" y="60" width="30" height="20" rx="2" fill="#93c5fd"/>
        <rect x="255" y="70" width="25" height="18" rx="2" fill="#93c5fd"/>
        <text x="200" y="20" text-anchor="middle" font-size="12" fill="#6b7280">Fleet: <%= total %> vehicles</text>
      </svg>
    </div>

    <!-- Recent Vehicles -->
    <div class="card border-0 rounded-3 shadow-sm">
      <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">Recent Vehicles</h6>
        <a href="/vehicles" class="btn btn-outline-secondary btn-sm">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Plate</th>
                <th>Model</th>
                <th>Mileage</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (vehicles.length === 0) { %>
              <tr><td colspan="5" class="text-center text-muted py-4">No vehicles found. <a href="/vehicles/new">Add one</a>.</td></tr>
              <% } %>
              <% vehicles.slice(0, 5).forEach(v => { %>
              <tr>
                <td class="fw-semibold"><%= v.license_plate %></td>
                <td><%= v.make_model %></td>
                <td><%= Number(v.current_mileage).toLocaleString() %> km</td>
                <td>
                  <span class="badge rounded-pill px-3 py-1
                    <%= v.status === 'Available' ? 'badge-available' : v.status === 'Maintenance' ? 'badge-maintenance' : 'badge-other' %>">
                    <%= v.status %>
                  </span>
                </td>
                <td>
                  <a href="/vehicles/<%= v.id %>/edit" class="btn btn-sm btn-outline-primary me-1">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form action="/vehicles/<%= v.id %>/delete" method="POST" class="d-inline"
                        onsubmit="return confirm('Delete this vehicle?')">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
