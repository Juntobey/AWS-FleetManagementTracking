<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Vehicle – Fleet Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    body { background:#f0f2f5; }
    .sidebar-link {
      display:block; color:#adb5bd; text-decoration:none;
      padding:.6rem .8rem; border-radius:6px; margin-bottom:4px; font-size:.9rem;
    }
    .sidebar-link:hover, .sidebar-link.active { background:#343a40; color:#fff; }
  </style>
</head>
<body class="d-flex flex-column" style="min-height:100vh;">

<%- include('partials/navbar', { page: 'vehicles' }) %>

<div class="d-flex flex-grow-1">
  <%- include('partials/sidebar', { page: 'vehicles' }) %>

  <main class="flex-grow-1 p-4">
    <div class="d-flex align-items-center mb-4">
      <a href="/vehicles" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
      </a>
      <h4 class="fw-bold mb-0">Edit Vehicle</h4>
    </div>

    <div class="card border-0 rounded-3 shadow-sm" style="max-width:560px;">
      <div class="card-body p-4">
        <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form action="/vehicles/<%= vehicle.id %>/edit" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold">License Plate</label>
            <input type="text" name="license_plate" class="form-control"
                   value="<%= vehicle.license_plate %>" required/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Make / Model</label>
            <input type="text" name="make_model" class="form-control"
                   value="<%= vehicle.make_model %>" required/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Current Mileage (km)</label>
            <input type="number" name="current_mileage" class="form-control"
                   value="<%= vehicle.current_mileage %>" min="0" required/>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Status</label>
            <select name="status" class="form-select" required>
              <option value="Available"    <%= vehicle.status === 'Available'    ? 'selected' : '' %>>Available</option>
              <option value="Maintenance"  <%= vehicle.status === 'Maintenance'  ? 'selected' : '' %>>Maintenance</option>
              <option value="In Use"       <%= vehicle.status === 'In Use'       ? 'selected' : '' %>>In Use</option>
            </select>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i>Save Changes
            </button>
            <a href="/vehicles" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
        <form action="/vehicles/<%= vehicle.id %>/delete" method="POST" class="mt-2"
              onsubmit="return confirm('Delete this vehicle?')">
          <button class="btn btn-outline-danger">
            <i class="bi bi-trash me-1"></i>Delete
          </button>
        </form>
      </div>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
